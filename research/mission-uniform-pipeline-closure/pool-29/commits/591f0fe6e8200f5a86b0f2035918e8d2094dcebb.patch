+from unittest.mock import patch
+
+from binding_support import MemoryRunner, NoNativeCase, make_plan, make_sink, option
+from verification import evidence, reporting
+
+
+class LinuxBindingCompositionTests(NoNativeCase):
+    def setup_pipeline(self, *, permission=True):
+        self.plan = make_plan(permission=permission)
+        self.runner = MemoryRunner(self.root, self.plan)
+        self.sink = make_sink(self.root, self.plan, self.runner)
+        # The metadata boundary is tested separately with strict tool doubles.
+        self.stack.enter_context(patch.object(self.adapter, 'collect_environment', return_value={
+            'platform': 'linux', 'os': 'synthetic only', 'architecture': 'synthetic x86_64'}))
+
+    def prepared(self):
+        result = evidence.prepare(self.plan, self.adapter, self.sink)
+        self.assertEqual(result.state, 'COMPLETED', 'Prepare binding absent or malformed; inspect preserved causes')
+        self.assertEqual(result.details['exit_code'], 0)
+        return result
+
+    def built(self):
+        result = evidence.build(self.plan, self.prepared(), self.adapter, self.sink)
+        self.assertEqual(result.state, 'COMPLETED')
+        self.assertEqual(result.details['exit_code'], 0)
+        return result
+
+    def test_without_dependency_optin_real_core_blocks_before_helper(self):
+        self.setup_pipeline(permission=False)
+        result = evidence.prepare(self.plan, self.adapter, self.sink)
+        self.assertEqual(result.state, 'BLOCKED')
+        self.assertEqual(result.details['exit_code'], 3)
+        self.assertEqual(self.runner.calls, [])
+
+    def test_prepare_build_run_receipts_and_raw_identity_stay_separate(self):
+        self.setup_pipeline()
+        prepared = self.prepared()
+        self.assertEqual([c.phase for c in self.runner.calls], ['prepare'])
+        self.assertNotIn('build', self.sink.manifest['receipts'])
+        built = evidence.build(self.plan, prepared, self.adapter, self.sink)
+        self.assertEqual(built.state, 'COMPLETED')
+        self.assertEqual([c.phase for c in self.runner.calls], ['prepare', 'build'])
+        self.assertNotIn('run', self.sink.manifest['receipts'])
+        self.assertEqual(built.details['build_root'], str(self.root / 'out' / 'build' / 'linux-debug'))
+        result = evidence.execute(self.plan, built, self.adapter, self.sink)
+        self.assertEqual([c.phase for c in self.runner.calls], ['prepare', 'build', 'run'])
+        self.assertEqual(result.state, 'COMPLETED')
+        self.assertEqual(result.details['exit_code'], 0)
+        self.assertEqual(self.sink.manifest['test_verdict'], 'PASS')
+        self.assertEqual(self.sink.manifest['measurement_validity'], 'NOT_REQUESTED')
+        for record in (prepared, built, result):
+            self.assertEqual(record.run_id, self.sink.run_id)
+            self.assertEqual(record.plan_sha256, self.plan.plan_sha256)
+        command = self.runner.calls[-1]
+        self.assertEqual(command.argv[0], str(self.root / built.details['executables']['ArtistUniformCpuWorkload']))
+        raw = Path(option(command.argv, '--result'))
+        document = json.loads(raw.read_text(encoding='utf-8'))
+        self.assertEqual(document['request_id'], option(command.argv, '--request-id'))
+        self.assertEqual(result.artifacts[raw.relative_to(self.sink.bundle).as_posix()],
+                         hashlib.sha256(raw.read_bytes()).hexdigest())
+        report = reporting.report(self.sink.bundle)
+        self.assertEqual(report['exit_code'], 0)
+
+    def test_foreign_preparation_is_refused_before_describing_build_or_child(self):
+        self.setup_pipeline()
+        prepared = self.prepared()
+        foreign = replace(prepared, run_id='foreign-run')
+        calls = len(self.runner.calls)
+        with patch.object(self.adapter, 'describe_build', side_effect=AssertionError('Must refuse before adapter')):
+            with self.assertRaises(evidence.EvidenceError):
