+"""Owned in-process fixtures; no child, native tool, network or GL fallback.
+
+Only the lead may import/run this candidate. The author uses AST parsing only.
+"""
+from contextlib import ExitStack, contextmanager
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+SCRIPTS = ROOT / 'scripts'
+if str(SCRIPTS) not in sys.path:
+    sys.path.insert(0, str(SCRIPTS))
+
+from verification import catalogue, evidence, planning
+from verification.model import BuildReceipt, PreparationReceipt, ProcessOutcome, Request
+from verification.scenarios.protocol import parse_workload_result
+
+
+def option(argv, name):
+    return argv[argv.index(name) + 1]
+
+
+def repeated_options(argv, name):
+    return [argv[index + 1] for index, value in enumerate(argv) if value == name]
+
+
+def make_plan(*, profile='cpu-only', configuration='debug', scenarios=None,
+              permission=True, routes=(), measurement=False, target=True):
+    if scenarios is None:
+        scenarios = ('cpu.float-mirror',) if profile == 'cpu-only' else ('gl.float-routes-correctness',)
+    expected = {}
+    if profile == 'opengl-hardware' and target:
+        expected = dict(expected_gl_vendor='Synthetic exact vendor',
+                        expected_gl_renderer='Synthetic exact renderer')
+    request = Request('linux', profile, tuple(scenarios), configuration,
+                      routes=routes, iterations=3, repetitions=2, batch_size=16,
+                      measurement_requested=measurement,
+                      allow_dependency_resolution=permission, **expected)
+    return planning.make_plan(request, catalogue.list_scenarios())
+
+
+def receipt(root, plan, *, kind=BuildReceipt, run_id='owned-run-a', bundle=None):
+    bundle = bundle or root / 'out' / 'verification' / run_id
+    build_root = root / 'out' / 'build' / ('linux-' + plan.request.configuration)
+    executables = {
+        target: (build_root / 'admitted executable paths' / target).relative_to(root).as_posix()
+        for spec in plan.scenarios for target in spec.targets
+    }
+    details = dict(bundle=str(bundle), source_root=str(root), build_root=str(build_root),
+                   exit_code=0, identity=dict(files={path: '1' * 64 for path in executables.values()}))
+    if kind is BuildReceipt:
+        details['executables'] = executables
+    return kind(1, run_id, plan.plan_sha256,
+                'build' if kind is BuildReceipt else 'prepare', 'COMPLETED', {}, details)
+
+
+def load_helper():
+    spec = importlib.util.spec_from_file_location('pool29_linux_helper_under_test', SCRIPTS / 'build-linux.py')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class UnreadableEnvironment(dict):
+    def deny(self, *args, **kwargs):
+        raise AssertionError('A pure description must not observe or modify ambient environment')
+
+    __getitem__ = __setitem__ = __delitem__ = __iter__ = __len__ = __contains__ = deny
+    get = copy = items = keys = values = clear = pop = popitem = update = setdefault = deny
+
+
+@contextmanager
+def no_observations():
+    """Descriptions must not even stat/resolve paths or probe ambient state."""
+    with ExitStack() as stack:
+        for name in ('resolve', 'stat', 'lstat', 'exists', 'is_file', 'is_dir', 'open',
+                     'read_bytes', 'read_text', 'write_bytes', 'write_text', 'mkdir',
+                     'iterdir', 'glob', 'rglob'):
+            stack.enter_context(patch.object(Path, name, side_effect=AssertionError('Description filesystem access: ' + name)))
+        for name in ('getcwd', 'getenv', 'scandir', 'listdir', 'stat', 'lstat', 'access', 'open', 'readlink'):
+            stack.enter_context(patch.object(os, name, side_effect=AssertionError('Description ambient probe: ' + name)))
+        stack.enter_context(patch('builtins.open', side_effect=AssertionError('Description open')))
+        stack.enter_context(patch.object(os, 'environ', UnreadableEnvironment()))
+        yield
+
+
+class NoNativeCase(unittest.TestCase):
+    def setUp(self):
+        self.stack = ExitStack()
+        self.addCleanup(self.stack.close)
+        for name in ('Popen', 'run', 'call', 'check_call', 'check_output'):
+            self.stack.enter_context(patch.object(subprocess, name, side_effect=AssertionError('Native child forbidden: ' + name)))
+        for name in ('system', 'popen'):
+            self.stack.enter_context(patch.object(os, name, side_effect=AssertionError('Shell forbidden: ' + name)))
+        for name in ('socket.socket', 'socket.create_connection'):
+            self.stack.enter_context(patch(name, side_effect=AssertionError('Network forbidden')))
+        self.root = Path(self.stack.enter_context(tempfile.TemporaryDirectory(
+            prefix='artist pool29 Linux binding with spaces '))).resolve()
+        # Never let a faulty collector expose the runner's real environment in
+        # assertion output. Even negative tests see only non-secret sentinels.
+        self.stack.enter_context(patch.dict(os.environ, {
+            'PATH': 'owned synthetic path', 'SECRET_FIXTURE_TOKEN': 'NOT_FOR_EVIDENCE'}, clear=True))
+        from verification.adapters.linux import LinuxAdapter
+        self.adapter_type = LinuxAdapter
+        self.adapter = LinuxAdapter(self.root)
+
+
+class MemoryRunner:
+    """Finite vocabulary, writes only owned fixture data; never delegates."""
+    def __init__(self, root, plan):
+        self.root, self.plan = root, plan
+        self.calls = []
+        self.failure_phase = None
+        self.domain_fail = False
+        self.omit_result = False
+
+    def run(self, command):
+        self.calls.append(command)
+        argv = command.argv
+        if command.phase in ('prepare', 'build'):
+            if argv[:3] != (sys.executable, '-B', str(self.root / 'scripts' / 'build-linux.py')):
+                raise AssertionError('Only the described historical helper is admitted by this double')
+            if command.phase == self.failure_phase:
+                return ProcessOutcome(17, 'synthetic partial stdout', 'synthetic failure', False, False)
+            if command.phase == 'prepare':
+                if '--configure-only' not in argv or '--build-only' in argv:
+                    raise AssertionError('Preparation must be configure-only')
+            else:
+                if '--build-only' not in argv or '--configure-only' in argv:
+                    raise AssertionError('Construction must be build-only')
+                tree = self.root / 'out' / 'build' / ('linux-' + self.plan.request.configuration)
+                for spec in self.plan.scenarios:
+                    for target in spec.targets:
+                        path = tree / 'admitted executable paths' / target
+                        path.parent.mkdir(parents=True, exist_ok=True)
+                        path.write_bytes(b'owned inert synthetic data, never executable')
+            return ProcessOutcome(0, 'synthetic helper output', '', False, False)
+        if command.phase != 'run' or '--result' not in argv:
+            raise AssertionError('This composition double admits only direct CPU protocol commands')
+        target = self.root / 'out' / 'build' / ('linux-' + self.plan.request.configuration) / 'admitted executable paths' / 'ArtistUniformCpuWorkload'
+        if argv[0] != str(target):
+            raise AssertionError('Workload must use the exact BuildReceipt mapping')
+        if not self.omit_result:
+            request = self.plan.request
+            count = request.iterations * request.repetitions * request.batch_size
+            document = dict(
+                schema_version=1, run_id=option(argv, '--run-id'),
+                request_id=option(argv, '--request-id'), plan_sha256=option(argv, '--plan-sha256'),
+                scenario=option(argv, '--scenario'), scenario_version=1, route=option(argv, '--route'),
+                profile='cpu-only', parameters=dict(iterations=request.iterations,
+                    repetitions=request.repetitions, batch_size=request.batch_size, measurement_requested=False),
+                operations_expected=dict(updates=count, draws=0),
+                operations_observed=dict(updates=0 if self.domain_fail else count, draws=0),
+                test_verdict='FAIL' if self.domain_fail else 'PASS', measurement_validity='NOT_REQUESTED',
+                observations={}, samples=[], environment={})
+            with Path(option(argv, '--result')).open('x', encoding='utf-8') as stream:
+                json.dump(document, stream)
+        return ProcessOutcome(10 if self.domain_fail else 0, 'synthetic workload output', '', False, False)
+
+
+def make_sink(root, plan, runner):
+    # These inert bytes are inventoried by the real sink; no source/tool import.
+    helper = root / 'scripts' / 'build-linux.py'
+    helper.parent.mkdir(parents=True, exist_ok=True)
+    helper.write_bytes(b'owned inert helper identity')
+    for spec in plan.scenarios:
+        for relative in spec.fixtures:
+            path = root / relative
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_bytes(b'owned inert source fixture')
+    return evidence.BundleSink(root, root / 'out' / 'verification', runner=runner,
+        revision_reader=lambda source: dict(head='1' * 40, delta='owned synthetic delta'),
+        result_parser=parse_workload_result)
