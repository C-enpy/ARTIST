+"""Proposed helper switches: causal RED must be run by the lead, not author."""
+from contextlib import redirect_stderr, redirect_stdout
+import io
+import os
+from pathlib import Path
+import subprocess
+from unittest.mock import patch
+
+from binding_support import NoNativeCase, load_helper, option
+
+
+class LinuxBindingHelperTests(NoNativeCase):
+    def setUp(self):
+        super().setUp()
+        self.module = load_helper()
+        self.module.__file__ = str(self.root / 'scripts' / 'build-linux.py')
+        self.calls = []
+        self.failure = None
+        self.stack.enter_context(patch.dict(os.environ, {'CONAN_HOME': 'parent cache sentinel'}, clear=True))
+        self.environment = dict(os.environ)
+        self.stack.enter_context(patch('subprocess.run', side_effect=self.record))
+
+    def record(self, argv, **kwargs):
+        self.assertIsInstance(argv, (list, tuple))
+        self.assertFalse(kwargs.get('shell', False))
+        self.assertEqual(kwargs['cwd'], self.root)
+        self.assertTrue(kwargs['check'])
+        self.calls.append((list(argv), kwargs['env'].copy()))
+        if self.failure:
+            raise self.failure
+        return subprocess.CompletedProcess(argv, 0)
+
+    def invoke(self, argv):
+        with redirect_stderr(io.StringIO()) as err, redirect_stdout(io.StringIO()):
+            try:
+                result = self.module.main(argv)
+            except SystemExit as stopped:
+                self.fail('Missing proposed helper mode, not an admissible parser success: '
+                          f'{stopped.code}: {err.getvalue().strip()}')
+        self.assertEqual(dict(os.environ), self.environment)
+        return result
+
+    def test_build_only_each_configuration_and_asan_never_prepares_tests_or_canary(self):
+        for configuration, asan, preset in (
+            ('debug', False, 'linux-debug'), ('release', False, 'linux-release'),
+            ('debug', True, 'linux-debug-asan'),
+        ):
+            with self.subTest(preset=preset):
+                self.calls.clear()
+                args = ['--configuration', configuration, '--build-only', '--jobs', '2',
+                        '--target', 'ArtistLib_tests', '--target', 'ArtistUniformCpuWorkload',
+                        '--target', 'ArtistLib_tests']
+                if asan:
+                    args.append('--address-sanitizer')
+                with patch.object(Path, 'mkdir', side_effect=AssertionError('Build-only must not create logs')):
+                    self.assertEqual(self.invoke(args), 0)
+                self.assertEqual([argv for argv, _ in self.calls], [
+                    ['cmake', '--build', '--preset', preset, '--target',
+                     'ArtistLib_tests', 'ArtistUniformCpuWorkload', '--parallel', '2']])
+
+    def test_verification_prepare_orders_conan_host_build_then_opted_in_cmake_only(self):
+        for configuration, asan in (('debug', False), ('release', False), ('debug', True)):
+            with self.subTest(configuration=configuration, asan=asan):
+                self.calls.clear()
+                args = ['--configuration', configuration, '--configure-only', '--verification-workloads']
+                if asan:
+                    args.append('--address-sanitizer')
+                with patch.object(Path, 'mkdir', side_effect=AssertionError('Prepare must not create run logs')):
+                    self.assertEqual(self.invoke(args), 0)
+                self.assertEqual(len(self.calls), 2)
+                install, configure = [argv for argv, _ in self.calls]
+                self.assertEqual(install[:3], ['conan', 'install', '.'])
+                profile = str(self.root / 'conan' / 'profiles' / 'linux-gcc')
+                self.assertEqual(option(install, '-pr:h'), profile)
+                self.assertEqual(option(install, '-pr:b'), profile)
+                for context in ('h', 'b'):
+                    self.assertEqual(option(install, '-s:' + context), 'build_type=' + configuration.capitalize())
+                preset = 'linux-' + configuration + ('-asan' if asan else '')
+                self.assertEqual(option(install, '-of'), str(self.root / 'out' / 'build' / preset))
+                self.assertEqual(configure, ['cmake', '--fresh', '--preset', preset,
+                                             '-DARTIST_BUILD_VERIFICATION=ON'])
+                if asan:
+                    for _, env in self.calls:
+                        self.assertEqual(env['ASAN_OPTIONS'], self.module.CANONICAL_ASAN_OPTIONS)
+                        self.assertNotIn('ASAN_ACTIVATION_OPTIONS', env)
+
+    def test_new_modes_reject_incompatible_or_empty_selections_before_commands(self):
+        invalid = (
+            ['--build-only'], ['--target', 'ArtistLib_tests'],
+            ['--configure-only', '--target', 'ArtistLib_tests'],
+            ['--configure-only', '--build-only', '--target', 'ArtistLib_tests'],
+            ['--verification-workloads'],
+            ['--build-only', '--verification-workloads', '--target', 'ArtistLib_tests'],
+            ['--build-only', '--target', ''],
+            ['--configuration', 'release', '--address-sanitizer', '--build-only', '--target', 'ArtistLib_tests'],
+        )
+        for args in invalid:
+            with self.subTest(args=args), redirect_stderr(io.StringIO()):
+                with self.assertRaises(SystemExit) as stopped:
+                    self.module.main(args)
+                self.assertEqual(stopped.exception.code, 2)
+                self.assertEqual(self.calls, [])
+
+    def test_build_only_preserves_native_failure_without_reconfiguration(self):
+        self.failure = subprocess.CalledProcessError(17, ['cmake'])
+        self.assertEqual(self.invoke(['--build-only', '--target', 'ArtistLib_tests']), 17)
+        self.assertEqual(len(self.calls), 1)
+        self.assertEqual(self.calls[0][0][:2], ['cmake', '--build'])
+
+    def test_build_only_missing_tool_is_not_a_repair_trigger(self):
+        self.failure = FileNotFoundError('owned missing cmake')
+        self.assertEqual(self.invoke(['--build-only', '--target', 'ArtistLib_tests']), 1)
+        self.assertEqual(len(self.calls), 1)
+
+    def test_verification_conan_failure_stops_before_configuration(self):
+        self.failure = subprocess.CalledProcessError(17, ['conan'])
+        self.assertEqual(self.invoke(['--configure-only', '--verification-workloads']), 17)
+        self.assertEqual(len(self.calls), 1)
+        self.assertEqual(self.calls[0][0][:2], ['conan', 'install'])
