+        self.assertEqual(result.state, 'FAILED')
+        self.assertEqual(result.details['exit_code'], 4)
+        self.assertNotEqual(self.sink.manifest['test_verdict'], 'PASS')
+
+    def test_mutated_binary_refused_before_execution_and_no_implicit_repair(self):
+        self.setup_pipeline()
+        built = self.built()
+        mapped = self.root / built.details['executables']['ArtistUniformCpuWorkload']
+        mapped.write_bytes(b'changed inert fixture')
+        calls = len(self.runner.calls)
+        result = evidence.execute(self.plan, built, self.adapter, self.sink)
+        self.assertEqual(result.details['exit_code'], 4)
+        self.assertEqual(self.sink.manifest['freshness'], 'STALE')
+        self.assertEqual(len(self.runner.calls), calls)
