+"""Real consultative CLI, no adapter selection or side effects permitted."""
+from contextlib import redirect_stderr, redirect_stdout
+import importlib.util
+import io
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+from binding_support import NoNativeCase, SCRIPTS
+
+
+class LinuxBindingPureCliTests(NoNativeCase):
+    def invoke(self, argv):
+        spec = importlib.util.spec_from_file_location('pool29_verification_cli', SCRIPTS / 'verify.py')
+        cli = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(cli)
+        before = sorted(path.relative_to(self.root).as_posix() for path in self.root.rglob('*'))
+        out, err = io.StringIO(), io.StringIO()
+        def forbidden_adapter(*args):
+            raise AssertionError('Consultative modes must not construct or observe an adapter')
+        with patch.object(cli, '_adapter', side_effect=forbidden_adapter), \
+             patch.object(Path, 'mkdir', side_effect=AssertionError('Consultative directory creation')), \
+             patch.object(Path, 'write_text', side_effect=AssertionError('Consultative write')), \
+             patch.object(Path, 'write_bytes', side_effect=AssertionError('Consultative write')), \
+             redirect_stdout(out), redirect_stderr(err):
+            code = cli.main(argv, source_root=self.root, adapter_factory=forbidden_adapter,
+                            runner=object())
+        self.assertEqual(code, 0, err.getvalue())
+        self.assertEqual(sorted(path.relative_to(self.root).as_posix() for path in self.root.rglob('*')), before)
+        return json.loads(out.getvalue())
+
+    def test_list_remains_consultative_with_linux_binding_present(self):
+        document = self.invoke(['list', '--json'])
+        self.assertTrue(document['scenarios'])
+
+    def test_plan_retains_unresolved_toolchain_and_gl_without_adapter_observation(self):
+        document = self.invoke(['plan', '--platform', 'linux', '--profile', 'opengl-hardware',
+                                '--scenario', 'gl.float-preparation', '--configuration', 'release'])
+        self.assertEqual(document['commands'], [])
+        self.assertIn('toolchain', document['unresolved'])
+        self.assertIn('gl_context', document['unresolved'])
+        self.assertIn('expected_gl_target', document['unresolved'])
