+    def test_c4_assertion_precondition_protocol_priorities_are_order_independent(self):
+        for protocol_error, expected_code in ((False, 5), (True, 4)):
+            results = []
+            for reverse in (False, True):
+                with self.subTest(protocol_error=protocol_error, reverse=reverse):
+                    fixture = self.fixture(reverse=reverse)
+                    unavailable_name, failed_name = [n for n in fixture.names if n.startswith('opengl.')]
+                    def mutate(suite, expected):
+                        by_name = {case.attrib['name']: case for case in suite}
+                        unavailable(by_name[unavailable_name], expected[unavailable_name])
+                        ET.SubElement(by_name[failed_name], 'failure').text = 'owned real JUnit assertion'
+                        if protocol_error:
+                            by_name[failed_name].find('system-out').text = '[ARTIST_CONTEXT_V1] {'
+                    fixture.mutation, fixture.returncode = mutate, 8
+                    codes = (3, 5, 4) if protocol_error else (3, 5)
+                    manifest = self.classified(fixture, expected_code, causes=codes)
+                    self.assertEqual(manifest['test_verdict'], 'FAIL', 'real assertions remain visible')
+                    summary = self.population(fixture)
+                    self.assertEqual(summary['failures'], [failed_name])
+                    self.assertEqual(summary['skips'], [unavailable_name])
+                    results.append((manifest['exit_code'], manifest['test_verdict'],
+                                    sorted(c['exit_code'] for c in manifest['causes']),
+                                    sorted(summary['selected_names']), summary['executed']))
+                    report = self.readonly_report(fixture)
+                    self.assertEqual(report['exit_code'], expected_code)
+                    self.assertTrue(set(codes).issubset({c['exit_code'] for c in report['causes']}))
+            self.assertEqual(results[0], results[1])
