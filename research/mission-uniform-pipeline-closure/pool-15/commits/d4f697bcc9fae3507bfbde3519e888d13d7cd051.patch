@@ -0,0 +1,398 @@
+"""C1-C7 / QA A3-A8: composed context consumer, synthetic data only.
+
+Author proposes; lead runs. No guard is bypassed and no acquired test is edited.
+All phases use RuntimeFixture-derived explicit doubles, real JUnit files and
+the integrated pure context parser. No child, CTest, engine, GL or build tool.
+"""
+from contextlib import ExitStack
+import json
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+import xml.etree.ElementTree as ET
+
+sys.dont_write_bytecode = True
+SCRIPTS = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(SCRIPTS.parent))
+sys.path.insert(0, str(SCRIPTS))
+
+from verification import context_evidence, evidence, reporting
+from context_collector_fixtures import (ContextFixture, encoded, gpu_cases,
+                                       observation, reindex_owned_artifact, unavailable)
+
+REAL_CONTEXT_PARSER = context_evidence.parse_context_observation
+
+
+class ContextCollectorContractTests(unittest.TestCase):
+    def setUp(self):
+        # Fail closed on accidental external execution, including the read-only
+        # report tests. The explicit fake runner itself only writes owned files.
+        for target in ('subprocess.Popen', 'subprocess.run', 'os.system',
+                       'socket.create_connection'):
+            self.enterContext(patch(target, side_effect=AssertionError('external effect forbidden')))
+
+    def fixture(self, **kwargs):
+        fixture = ContextFixture(**kwargs)
+        self.addCleanup(fixture.close)
+        return fixture
+
+    def built(self, fixture):
+        prepared = evidence.prepare(fixture.plan, fixture.adapter, fixture.sink)
+        self.assertEqual(prepared.state, 'COMPLETED', 'owned synthetic preparation must succeed')
+        built = evidence.build(fixture.plan, prepared, fixture.adapter, fixture.sink)
+        self.assertEqual(built.state, 'COMPLETED', 'owned synthetic build must succeed')
+        return built
+
+    def execute(self, fixture):
+        built = self.built(fixture)
+        receipt = evidence.execute(fixture.plan, built, fixture.adapter, fixture.sink)
+        return receipt, fixture.sink.manifest
+
+    def classified(self, fixture, code, *, causes=()):
+        receipt, manifest = self.execute(fixture)
+        self.assertEqual(manifest['exit_code'], code, manifest['causes'])
+        self.assertEqual(receipt.details['exit_code'], code)
+        self.assertTrue(set(causes).issubset({cause['exit_code'] for cause in manifest['causes']}))
+        if code:
+            self.assertNotEqual(manifest['test_verdict'], 'PASS')
+        return manifest
+
+    def population(self, fixture):
+        path = fixture.sink.bundle / 'raw' / 'ctest-population.json'
+        self.assertTrue(path.is_file(), 'keep parsed population even when a context is unavailable/invalid')
+        return json.loads(path.read_text(encoding='utf-8'))
+
+    def readonly_report(self, fixture):
+        def snapshot():
+            return {p.relative_to(fixture.root).as_posix():
+                    (p.read_bytes(), p.stat().st_mtime_ns)
+                    for p in fixture.root.rglob('*') if p.is_file()}
+        before = snapshot()
+        with ExitStack() as stack:
+            stack.enter_context(patch.object(fixture.runner, 'run', side_effect=AssertionError('no relaunch')))
+            stack.enter_context(patch.object(type(fixture.revision), '__call__', side_effect=AssertionError('no revision probe')))
+            stack.enter_context(patch.object(evidence, '_snapshot', side_effect=AssertionError('no live revision snapshot')))
+            stack.enter_context(patch.object(evidence, '_write_json', side_effect=AssertionError('no report write')))
+            result = reporting.report(fixture.sink.bundle)
+        self.assertEqual(snapshot(), before, 'report must not alter files or create cached evidence')
+        return result
+
+    def test_c0_fixture_roundtrip_is_valid_real_junit_and_real_parser_without_consumer(self):
+        fixture = self.fixture()
+        built = self.built(fixture)
+        commands = fixture.adapter.describe_execution(fixture.plan, built)
+        for command in commands:
+            fixture.runner.run(command)  # Data/file double only; not evidence.execute.
+        seen = []
+        for command in commands:
+            if command.argv[1] != 'ctest':
+                continue
+            for case in ET.parse(Path(command.argv[-1])).iter('testcase'):
+                name = case.attrib['name']
+                if name.startswith('opengl.'):
+                    value = REAL_CONTEXT_PARSER(case.findtext('system-out'),
+                                                expected=fixture.expected(command, name))
+                    self.assertEqual(value['qualification'], 'MATCHED_EXPECTATION')
+                else:
+                    self.assertIsNone(case.find('system-out'))
+                seen.append(name)
+        self.assertCountEqual(seen, fixture.names)
+
+    def test_c1_nominal_composed_execution_calls_real_parser_per_gpu_case(self):
+        fixture = self.fixture()
+        with patch.object(context_evidence, 'parse_context_observation', wraps=REAL_CONTEXT_PARSER) as parser:
+            manifest = self.classified(fixture, 0)
+            calls = list(parser.call_args_list)
+        self.assertEqual((manifest['pipeline_state'], manifest['test_verdict'],
+                          manifest['measurement_validity']), ('COMPLETED', 'PASS', 'NOT_REQUESTED'))
+        names = [name for name in fixture.names if name.startswith('opengl.')]
+        self.assertCountEqual([call.kwargs['expected']['ctest_name'] for call in calls], names)
