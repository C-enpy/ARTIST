+"""Owned data/file doubles for the context consumer; never start a process.
+
+Reuse RuntimeFixture and the producer's existing synthetic observation builder.
+No parallel context schema/parser, native adapter, executable or GL fixture.
+"""
+from dataclasses import replace
+import json
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+from verification import evidence
+from verification.model import ProcessOutcome
+from runtime_fixtures import AdapterDouble, RunnerDouble, RuntimeFixture
+from scripts.tests.verification_context.test_context_evidence import encoded, observation
+
+
+class ContextAdapterDouble(AdapterDouble):
+    def collect_environment(self):
+        self.calls.append('environment')
+        return {'platform': self.fixture.plan.request.platform,
+                'python': 'synthetic interpreter', 'variables': {}}
+
+    def describe_execution(self, plan, build):
+        self.calls.append('run')
+        commands = [self.command(('owned-fake', 'discover', '--show-only=json-v1'), 'run')]
+        names = self.fixture.names
+        groups = (names,) if not self.fixture.split else (names[:1], names[1:])
+        for index, group in enumerate(groups):
+            request_id = build.run_id + '-owned-invocation-' + str(0 if self.fixture.duplicate_request else index)
+            path = Path(build.details['bundle']) / 'raw' / ('context-' + str(index) + '.xml')
+            delta = {
+                'ARTIST_VERIFICATION_CONTEXT_V1': plan.request.profile,
+                'ARTIST_VERIFICATION_RUN_ID': build.run_id,
+                'ARTIST_VERIFICATION_PLAN_SHA256': plan.plan_sha256,
+                'ARTIST_VERIFICATION_REQUEST_ID': request_id,
+                'ARTIST_VERIFICATION_EXPECTED_GL_VENDOR': plan.request.expected_gl_vendor,
+                'ARTIST_VERIFICATION_EXPECTED_GL_RENDERER': plan.request.expected_gl_renderer,
+            }
+            self.fixture.groups[str(path)] = tuple(group)
+            command = self.command(('owned-fake', 'ctest', '--no-tests=error',
+                                    '--output-junit', str(path)), 'run')
+            commands.append(replace(command, env_delta=delta))
+        return tuple(commands)
+
+
+class ContextRunnerDouble(RunnerDouble):
+    def run(self, command):
+        # This vocabulary is deliberately not executable, even if a real runner
+        # were accidentally substituted. No fallback or subprocess factory.
+        if command.argv[0] != 'owned-fake':
+            raise AssertionError('context fixture refuses every external tool')
+        if command.argv[1] != 'ctest':
+            return super().run(command)
+        self.calls.append(command)
+        fixture = self.fixture
+        path = Path(self.option(command.argv, '--output-junit'))
+        names = fixture.groups[str(path)]
+        if fixture.reverse:
+            names = tuple(reversed(names))
+        suite = ET.Element('testsuite')
+        expected = {}
+        for name in names:
+            case = ET.SubElement(suite, 'testcase', name=name)
+            if name.startswith('opengl.'):
+                identity = fixture.expected(command, name)
+                expected[name] = identity
+                ET.SubElement(case, 'system-out').text = encoded(observation(identity))
+        if fixture.mutation:
+            fixture.mutation(suite, expected)
+        if fixture.xml_mode != 'absent':
+            data = (b'<testsuite><testcase' if fixture.xml_mode == 'truncated'
+                    else ET.tostring(suite, encoding='utf-8', xml_declaration=True))
+            with path.open('xb') as stream:
+                stream.write(data)
+            fixture.raw[path] = data
+        stdout = 'owned CTest stdout, not a GL observation\n' + fixture.global_output
+        return ProcessOutcome(fixture.returncode, stdout, 'owned CTest stderr\n',
+                              False, fixture.interrupted)
+
+
+class ContextFixture(RuntimeFixture):
+    def __init__(self, *, split=False, reverse=False):
+        super().__init__(profile='opengl-hardware', scenario='gl.float-lifetime',
+                         target=(' Exact Véndor ', '\u00a0Exact Renderer \U0001f680 '))
+        self.names = tuple(self.plan.scenarios[0].producer['names'])
+        self.split, self.reverse = split, reverse
+        self.groups, self.raw = {}, {}
+        self.duplicate_request = False
+        self.mutation = None
+        self.xml_mode = 'valid'
+        self.returncode, self.interrupted = 0, False
+        self.global_output = ''
+        self.runner, self.adapter = ContextRunnerDouble(self), ContextAdapterDouble(self)
+        self.sink = evidence.BundleSink(self.root, self.output, runner=self.runner,
+                                        revision_reader=self.revision)
+
+    def expected(self, command, name):
+        return dict(run_id=self.sink.run_id, plan_sha256=self.plan.plan_sha256,
+                    request_id=command.env_delta['ARTIST_VERIFICATION_REQUEST_ID'],
+                    ctest_name=name, profile='opengl-hardware',
+                    expected_gl_vendor=self.plan.request.expected_gl_vendor,
+                    expected_gl_renderer=self.plan.request.expected_gl_renderer)
+
+
+def gpu_cases(suite):
+    return [case for case in suite if case.attrib['name'].startswith('opengl.')]
+
+
+def unavailable(case, expected, *, reason='owned context unavailable'):
+    value = observation(expected)
+    for key in ('gl_vendor', 'gl_renderer', 'gl_version', 'context_major',
+                'context_minor', 'context_profile_mask'):
+        value[key] = None
+    value.update(context_current=False, qualification='UNVERIFIED',
+                 precondition='UNAVAILABLE', reason=reason)
+    case.find('system-out').text = encoded(value)
+    ET.SubElement(case, 'skipped').text = 'owned synthetic refusal before body'
+
+
+def reindex_owned_artifact(fixture, path):
+    """Keep receipt/hash indexes consistent to isolate semantic report replay.
+
+    This is a test mutation, not a production signing or trust mechanism.
+    """
+    manifest_path = fixture.sink.bundle / 'manifest.json'
+    manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
+    relative = path.relative_to(fixture.sink.bundle).as_posix()
+    digest = fixture.hash(path)
+    manifest['artifacts'][relative] = digest
+    for receipt in manifest['receipts'].values():
+        if relative in receipt['artifacts']:
+            receipt['artifacts'][relative] = digest
+    manifest_path.write_text(json.dumps(manifest), encoding='utf-8')
