+"""Historical context observation boundary (RED scaffold, not a validator).
+
+Only the nominal JSON transport exists at this checkpoint. Do not integrate
+this scaffold as trusted evidence; the lead must observe the discriminating
+RED tests before the validation implementation is authored.
+"""
+
+import json
+
+
+def parse_context_observation(text: str, *, expected: dict) -> dict:
+    """Decode a nominal observation; validation deliberately awaits causal RED."""
+    prefix = "[ARTIST_CONTEXT_V1] "
+    for line in text.split("\n"):
+        if line.startswith(prefix):
+            return json.loads(line[len(prefix):])
+    raise ValueError("context observation absent")
