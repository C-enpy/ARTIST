{
    "version": 3,
    "configurePresets": [
        {
            "name": "conan-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "toolchainFile": "${sourceDir}/out/build/${presetName}/conan_toolchain.cmake",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "MOCK_GL": "ON",
                "COVERAGE": "OFF"
            }
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows x64 MSVC Debug (Conan 2)",
            "inherits": "conan-base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows x64 MSVC Release (Conan 2)",
            "inherits": "windows-msvc-debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (Conan 2, toolchain required)",
            "inherits": "conan-base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Debug (Conan 2, C++23 library required)",
            "inherits": "conan-base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        }
    ],
    "buildPresets": [
        { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
        { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" }
    ],
    "testPresets": [
        {
            "name": "windows-msvc-debug",
            "configurePreset": "windows-msvc-debug",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "jobs": 1 }
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc-release",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "jobs": 1 }
        }
    ]
}
